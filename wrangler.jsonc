{
  "name": "globalgreenenergy",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
{
  // ...
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  // ...
}
